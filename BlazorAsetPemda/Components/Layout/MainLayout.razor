@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Sistem Informasi Administrasi dan Penyusutan BMD</span>
            <AuthorizeView>
                <Authorized>
                    <span class="text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name
                    </span>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Terjadi kesalahan yang tidak tertangani.
    <a href="" class="reload">Muat Ulang</a>
    <a class="dismiss">🗙</a>
</div>
