            <div class="ps-4">
                <NavLink class="nav-link" href="pengguna-barang/penyusutan/kib-b">KIB B</NavLink>
                <NavLink class="nav-link" href="pengguna-barang/penyusutan/kib-c">KIB C</NavLink>
                <NavLink class="nav-link" href="pengguna-barang/penyusutan/kib-d">KIB D</NavLink>
                <NavLink class="nav-link" href="pengguna-barang/penyusutan/kib-e">KIB E</NavLink>
                <NavLink class="nav-link" href="pengguna-barang/penyusutan/kib-f">KIB F</NavLink>
