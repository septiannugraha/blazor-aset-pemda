@page "/"
@layout BlazorAsetPemda.Components.Account.Shared.AccountLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>SIAP BMD - Kabupaten Labuhanbatu Selatan</PageTitle>

<div class="home-page">
    <div class="home-container">
        <div class="home-card">
            <div class="home-header">
                <div class="home-logo">
                    <img src="/images/logo.png" alt="Logo Kabupaten Labuhanbatu Selatan" />
                </div>
                <p class="pemda-name">PEMERINTAH KABUPATEN LABUHANBATU SELATAN</p>
                <h1 class="app-title">Sistem Informasi Administrasi<br/>dan Penyusutan Barang Milik Daerah</h1>
                <p class="app-subtitle">SIAP BMD</p>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="welcome-box">
                        <p>Selamat datang, <strong>@context.User.Identity?.Name</strong>!</p>
                        <p class="text-muted">Anda akan diarahkan ke dashboard...</p>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="action-section">
                        <p class="action-text">Silakan masuk untuk mengakses sistem</p>
                        <a href="/Account/Login" class="btn-login">
                            <span class="bi bi-box-arrow-in-right me-2"></span>Masuk ke Sistem
                        </a>
                    </div>

                    <div class="demo-section">
                        <p class="demo-title">Akun Demo:</p>
                        <div class="demo-accounts">
                            <div class="demo-account">
                                <span class="demo-role">Pengelola Barang</span>
                                <span class="demo-credentials">pengelola@bmd.local / Pengelola123</span>
                            </div>
                            <div class="demo-account">
                                <span class="demo-role">Pengguna Barang</span>
                                <span class="demo-credentials">pengguna@bmd.local / Pengguna123</span>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <p class="footer-text">&copy; 2025 Pemerintah Kabupaten Labuhanbatu Selatan</p>
    </div>
</div>

<style>
    .home-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 50%, #3d7ab5 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .home-container {
        width: 100%;
        max-width: 500px;
    }

    .home-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .home-header {
        background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
    }

    .home-logo {
        margin-bottom: 20px;
    }

    .home-logo img {
        max-width: 120px;
        height: auto;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    }

    .pemda-name {
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 15px;
        color: #e0e0e0;
    }

    .app-title {
        font-size: 20px;
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 10px;
    }

    .app-subtitle {
        font-size: 28px;
        font-weight: 800;
        color: #ffd700;
        margin: 0;
    }

    .welcome-box {
        padding: 30px;
        text-align: center;
        background: #f8f9fa;
    }

    .action-section {
        padding: 30px;
        text-align: center;
    }

    .action-text {
        color: #666;
        margin-bottom: 20px;
    }

    .btn-login {
        display: inline-block;
        background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);
        color: white;
        padding: 15px 40px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        background: linear-gradient(135deg, #2d5a87 0%, #3d7ab5 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(30, 58, 95, 0.4);
    }

    .demo-section {
        padding: 20px 30px 30px;
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
    }

    .demo-title {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 15px;
        text-align: center;
    }

    .demo-accounts {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .demo-account {
        background: white;
        padding: 12px 15px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        border: 1px solid #e9ecef;
    }

    .demo-role {
        font-weight: 600;
        color: #1e3a5f;
    }

    .demo-credentials {
        color: #666;
        font-family: monospace;
        font-size: 12px;
    }

    .footer-text {
        text-align: center;
        color: rgba(255, 255, 255, 0.7);
        font-size: 12px;
        margin-top: 20px;
    }

    @@media (max-width: 480px) {
        .home-header {
            padding: 30px 20px;
        }

        .app-title {
            font-size: 18px;
        }

        .demo-account {
            flex-direction: column;
            text-align: center;
            gap: 5px;
        }
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            if (user.IsInRole("PengelolaBarang"))
            {
                NavigationManager.NavigateTo("/pengelola-barang/dashboard");
            }
            else if (user.IsInRole("PenggunaBarang"))
            {
                NavigationManager.NavigateTo("/pengguna-barang/dashboard");
            }
        }
    }
}
