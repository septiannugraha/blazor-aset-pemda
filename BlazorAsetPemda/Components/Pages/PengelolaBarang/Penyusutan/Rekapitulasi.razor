    private string FormatCurrency(decimal value)
    {
        if (value == 0) return "-";
        return value.ToString("N0", new System.Globalization.CultureInfo("id-ID"));
    }

    private string FormatCurrencyShort(decimal value)
    {
        if (value >= 1_000_000_000_000)
            return $"Rp {(value / 1_000_000_000_000):N2} T";
        if (value >= 1_000_000_000)
            return $"Rp {(value / 1_000_000_000):N2} M";
        if (value >= 1_000_000)
            return $"Rp {(value / 1_000_000):N2} Jt";
        return $"Rp {value:N0}";
    }

