@page "/pengelola-barang/penyusutan/rekapitulasi"
@attribute [Authorize(Roles = "PengelolaBarang,Admin")]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Rekapitulasi Penyusutan - SIAP BMD</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Rekapitulasi Penyusutan</h3>
            <p class="text-muted mb-0">Tahun Anggaran @TahunAnggaran</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="ExportExcel">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </button>
            <button class="btn btn-outline-secondary" @onclick="PrintReport">
                <i class="bi bi-printer me-1"></i> Cetak
            </button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-table me-2"></i>
                Rekapitulasi Nilai Aset dan Penyusutan per Jenis Aset
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center" style="width: 300px;">Jenis Aset</th>
                            <th class="text-center">Nilai Perolehan (Rp)</th>
                            <th class="text-center">Beban Penyusutan (Rp)</th>
                            <th class="text-center">Akumulasi Penyusutan (Rp)</th>
                            <th class="text-center">Nilai Buku (Rp)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in DataRekapitulasi)
                        {
                            var rowClass = item.Level switch
                            {
                                0 => "table-primary fw-bold",
                                1 => "table-light fw-semibold",
                                _ => ""
                            };
                            var indent = item.Level * 20;

                            <tr class="@rowClass">
                                <td style="padding-left: @(indent + 12)px;">@item.JenisAset</td>
                                <td class="text-end">@FormatCurrency(item.NilaiPerolehan)</td>
                                <td class="text-end text-danger">@FormatCurrency(item.BebanPenyusutan)</td>
                                <td class="text-end text-danger">@FormatCurrency(item.AkumulasiPenyusutan)</td>
                                <td class="text-end text-success fw-semibold">@FormatCurrency(item.NilaiBuku)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-dark">
                        <tr class="fw-bold">
                            <td class="text-center">GRAND TOTAL</td>
                            <td class="text-end">@FormatCurrency(GrandTotal.NilaiPerolehan)</td>
                            <td class="text-end">@FormatCurrency(GrandTotal.BebanPenyusutan)</td>
                            <td class="text-end">@FormatCurrency(GrandTotal.AkumulasiPenyusutan)</td>
                            <td class="text-end">@FormatCurrency(GrandTotal.NilaiBuku)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Total Nilai Perolehan</h6>
                            <h4 class="card-title mb-0">@FormatCurrencyShort(GrandTotal.NilaiPerolehan)</h4>
                        </div>
                        <i class="bi bi-cash-stack fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Beban Penyusutan</h6>
                            <h4 class="card-title mb-0">@FormatCurrencyShort(Math.Abs(GrandTotal.BebanPenyusutan))</h4>
                        </div>
                        <i class="bi bi-graph-down-arrow fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Akumulasi Penyusutan</h6>
                            <h4 class="card-title mb-0">@FormatCurrencyShort(Math.Abs(GrandTotal.AkumulasiPenyusutan))</h4>
                        </div>
                        <i class="bi bi-layers fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Nilai Buku</h6>
                            <h4 class="card-title mb-0">@FormatCurrencyShort(GrandTotal.NilaiBuku)</h4>
                        </div>
                        <i class="bi bi-journal-bookmark fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

