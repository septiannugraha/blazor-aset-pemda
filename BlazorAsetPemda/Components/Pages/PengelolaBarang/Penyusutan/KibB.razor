@page "/pengelola-barang/penyusutan/kib-b"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Penyusutan KIB B</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Penyusutan KIB B</h1>
            <p class="text-muted">Kelola penyusutan Peralatan dan Mesin (KIB B)</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-calculator-fill"></i> Hitung Penyusutan
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-calculator display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur penyusutan KIB B akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan perhitungan penyusutan untuk Peralatan dan Mesin (KIB B)</p>
        </div>
    </div>
</div>
