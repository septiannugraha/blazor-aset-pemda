@page "/pengelola-barang/dashboard"
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Dashboard - Pengelola Barang</PageTitle>

<h1 class="mb-4">Dashboard Pengelola Barang</h1>

<FilterComponent OnFilterChange="HandleFilterChange" />

<div class="row">
    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Total Aset Kabupaten</h6>
                        <h2 class="mb-0">@TotalAssets</h2>
                    </div>
                    <div>
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Total Nilai</h6>
                        <h2 class="mb-0 small">@TotalValue.ToString("C0")</h2>
                    </div>
                    <div>
                        <i class="bi bi-currency-dollar fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Total SKPD</h6>
                        <h2 class="mb-0">@TotalSKPD</h2>
                    </div>
                    <div>
                        <i class="bi bi-building fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Penyusutan Tahun Ini</h6>
                        <h2 class="mb-0 small">@CurrentYearDepreciation.ToString("C0")</h2>
                    </div>
                    <div>
                        <i class="bi bi-calculator fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Rekapitulasi Aset Berdasarkan KIB</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Jenis KIB</th>
                                <th class="text-end">Jumlah</th>
                                <th class="text-end">Nilai (Rp)</th>
                                <th class="text-end">Penyusutan (Rp)</th>
                                <th class="text-end">Nilai Buku (Rp)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in AssetsByKIB)
                            {
                                <tr>
                                    <td>KIB @item.KIBType</td>
                                    <td class="text-end">@item.Count</td>
                                    <td class="text-end">@item.TotalValue.ToString("N0")</td>
                                    <td class="text-end">@item.TotalDepreciation.ToString("N0")</td>
                                    <td class="text-end">@((item.TotalValue - item.TotalDepreciation).ToString("N0"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <th>Total</th>
                                <th class="text-end">@AssetsByKIB.Sum(a => a.Count)</th>
                                <th class="text-end">@AssetsByKIB.Sum(a => a.TotalValue).ToString("N0")</th>
                                <th class="text-end">@AssetsByKIB.Sum(a => a.TotalDepreciation).ToString("N0")</th>
                                <th class="text-end">@AssetsByKIB.Sum(a => a.TotalValue - a.TotalDepreciation).ToString("N0")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Top 5 SKPD (Nilai Aset)</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    @foreach (var skpd in TopSKPDs)
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@skpd.NamaSKPD</h6>
                            </div>
                            <p class="mb-1"><strong>@skpd.TotalAssets</strong> aset</p>
                            <small class="text-muted">Total: Rp @skpd.TotalValue.ToString("N0")</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Monitoring Belanja Modal Tahun @FilteredTahun</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>SKPD</th>
                                <th class="text-end">Jumlah Kontrak</th>
                                <th class="text-end">Nilai Kontrak (Rp)</th>
                                <th class="text-end">Aset Tersalur</th>
                                <th class="text-center">Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in BelanjaModalMonitoring)
                            {
                                var progress = item.NilaiKontrak > 0 ? (int)((item.NilaiTersalur / item.NilaiKontrak) * 100) : 0;
                                <tr>
                                    <td>@item.NamaSKPD</td>
                                    <td class="text-end">@item.JumlahKontrak</td>
                                    <td class="text-end">@item.NilaiKontrak.ToString("N0")</td>
                                    <td class="text-end">@item.JumlahAset</td>
                                    <td>
                                        <div class="progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @progress%"
                                                 aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                                                @progress%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int TotalAssets { get; set; }
    private decimal TotalValue { get; set; }
    private int TotalSKPD { get; set; }
    private decimal CurrentYearDepreciation { get; set; }
    private List<AssetByKIB> AssetsByKIB { get; set; } = new();
    private List<TopSKPD> TopSKPDs { get; set; } = new();
    private List<BelanjaModalMonitoringItem> BelanjaModalMonitoring { get; set; } = new();

    private int? FilteredPenggunaBarangId { get; set; }
    private string FilteredJenisTahun { get; set; } = "sampai-dengan";
    private int FilteredTahun { get; set; } = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task HandleFilterChange(FilterComponent.FilterParameters filters)
    {
        FilteredPenggunaBarangId = filters.PenggunaBarangId > 0 ? filters.PenggunaBarangId : null;
        FilteredJenisTahun = filters.JenisTahun;
        FilteredTahun = filters.Tahun;

        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Build base query with filters
        var query = context.Assets
            .Include(a => a.SKPD)
            .Include(a => a.Depreciations)
            .Include(a => a.Kontrak)
            .AsQueryable();

        // Apply filters
        if (FilteredPenggunaBarangId.HasValue)
        {
            query = query.Where(a => a.UpbId == FilteredPenggunaBarangId.Value);
        }

        if (FilteredJenisTahun == "hanya-tahun")
        {
            query = query.Where(a => a.Tahun == FilteredTahun);
        }
        else
        {
            query = query.Where(a => a.Tahun <= FilteredTahun);
        }

        // Load assets to memory for SQLite-compatible aggregation
        var assets = await query.ToListAsync();

        // Get statistics (client-side aggregation for SQLite compatibility)
        TotalAssets = assets.Count;
        TotalValue = assets.Sum(a => a.Harga);
        TotalSKPD = await context.SKPDs.Where(s => s.IsActive).CountAsync();

        // Get assets by KIB with depreciation (client-side)
        AssetsByKIB = assets
            .GroupBy(a => a.KIBType)
            .Select(g => new AssetByKIB
            {
                KIBType = g.Key,
                Count = g.Count(),
                TotalValue = g.Sum(a => a.Harga),
                TotalDepreciation = g
                    .SelectMany(a => a.Depreciations)
                    .Sum(d => d.AkumulasiPenyusutan)
            })
            .OrderBy(a => a.KIBType)
            .ToList();

        // Get top SKPDs (client-side)
        TopSKPDs = assets
            .Where(a => a.SKPD != null)
            .GroupBy(a => a.SKPD!.NamaSKPD)
            .Select(g => new TopSKPD
            {
                NamaSKPD = g.Key,
                TotalAssets = g.Count(),
                TotalValue = g.Sum(a => a.Harga)
            })
            .OrderByDescending(s => s.TotalValue)
            .Take(5)
            .ToList();

        // Get belanja modal monitoring (load data first, then aggregate client-side)
        var skpdsWithAssets = await context.SKPDs
            .Where(s => s.IsActive)
            .Include(s => s.Assets.Where(a => a.Tahun == FilteredTahun))
                .ThenInclude(a => a.Kontrak)
            .ToListAsync();

        BelanjaModalMonitoring = skpdsWithAssets
            .Select(s => new BelanjaModalMonitoringItem
            {
                NamaSKPD = s.NamaSKPD,
                JumlahKontrak = s.Assets
                    .Where(a => a.KontrakId != null)
                    .Select(a => a.KontrakId)
                    .Distinct()
                    .Count(),
                NilaiKontrak = s.Assets
                    .Where(a => a.Kontrak != null)
                    .Sum(a => a.Kontrak!.NilaiKontrak),
                JumlahAset = s.Assets.Count,
                NilaiTersalur = s.Assets.Sum(a => a.Harga)
            })
            .Where(s => s.JumlahKontrak > 0 || s.JumlahAset > 0)
            .OrderByDescending(s => s.NilaiKontrak)
            .ToList();

        // Get current year depreciation (load and aggregate client-side)
        var depreciationQuery = context.Depreciations
            .Where(d => d.Tahun == DateTime.Now.Year);

        if (FilteredPenggunaBarangId.HasValue)
        {
            depreciationQuery = depreciationQuery
                .Include(d => d.Asset)
                .Where(d => d.Asset.UpbId == FilteredPenggunaBarangId.Value);
        }

        var depreciations = await depreciationQuery.ToListAsync();
        CurrentYearDepreciation = depreciations.Sum(d => d.NilaiPenyusutan);
    }

    public class AssetByKIB
    {
        public KIBType KIBType { get; set; }
        public int Count { get; set; }
        public decimal TotalValue { get; set; }
        public decimal TotalDepreciation { get; set; }
    }

    public class TopSKPD
    {
        public string NamaSKPD { get; set; } = string.Empty;
        public int TotalAssets { get; set; }
        public decimal TotalValue { get; set; }
    }

    public class BelanjaModalMonitoringItem
    {
        public string NamaSKPD { get; set; } = string.Empty;
        public int JumlahKontrak { get; set; }
        public decimal NilaiKontrak { get; set; }
        public int JumlahAset { get; set; }
        public decimal NilaiTersalur { get; set; }
    }
}
