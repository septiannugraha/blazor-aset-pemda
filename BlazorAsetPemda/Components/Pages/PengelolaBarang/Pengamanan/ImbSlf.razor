@page "/pengelola-barang/pengamanan/imb-slf"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>IMB dan SLF</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">IMB dan SLF</h1>
            <p class="text-muted">Kelola data IMB (Izin Mendirikan Bangunan) dan SLF (Sertifikat Laik Fungsi)</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Data
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-building display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur IMB dan SLF akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar IMB dan SLF bangunan milik daerah</p>
        </div>
    </div>
</div>
