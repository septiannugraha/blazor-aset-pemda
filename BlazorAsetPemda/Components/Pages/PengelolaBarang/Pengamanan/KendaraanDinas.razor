@page "/pengelola-barang/pengamanan/kendaraan-dinas"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Kendaraan Dinas</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Kendaraan Dinas</h1>
            <p class="text-muted">Kelola data BPKB, STNK, Izin Penggunaan, dan Monitoring Lokasi kendaraan dinas</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Data Kendaraan
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-car-front display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur kendaraan dinas akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar BPKB, STNK, izin penggunaan, serta monitoring lokasi kendaraan dinas</p>
        </div>
    </div>
</div>
