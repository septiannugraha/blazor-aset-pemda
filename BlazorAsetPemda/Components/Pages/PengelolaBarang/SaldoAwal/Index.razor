@page "/pengelola-barang/saldo-awal"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout
@inject AssetService AssetService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using BlazorAsetPemda.Data.Enums

<PageTitle>Saldo Awal - Aset</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Saldo Awal</h1>
            <p class="text-muted">Data Awal Barang Milik Daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/pengelola-barang/saldo-awal/tambah")'>
                <i class="bi bi-plus-circle"></i> Tambah Aset
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Cari</label>
                    <input type="text" class="form-control" placeholder="Nomor Register, Nama Barang..."
                           @bind="SearchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">SKPD</label>
                    <select class="form-select" @bind="SelectedSkpdId" @bind:event="onchange" @bind:after="OnSkpdChanged">
                        <option value="">Semua SKPD</option>
                        @foreach (var skpd in SKPDs)
                        {
                            <option value="@skpd.Id">@skpd.KodeSKPD - @skpd.NamaSKPD</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">UPB</label>
                    <select class="form-select" @bind="SelectedUpbId">
                        <option value="">Semua UPB</option>
                        @foreach (var upb in UPBs)
                        {
                            <option value="@upb.Id">@upb.KodeUPB - @upb.NamaUPB</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipe KIB</label>
                    <select class="form-select" @bind="SelectedKIBType">
                        <option value="">Semua KIB</option>
                        <option value="@KIBType.A">KIB A - Tanah</option>
                        <option value="@KIBType.B">KIB B - Peralatan & Mesin</option>
                        <option value="@KIBType.C">KIB C - Gedung & Bangunan</option>
                        <option value="@KIBType.D">KIB D - Jalan, Irigasi, Jaringan</option>
                        <option value="@KIBType.E">KIB E - Aset Tetap Lainnya</option>
                        <option value="@KIBType.F">KIB F - Konstruksi dlm Pengerjaan</option>
                        <option value="@KIBType.Lainnya">Lainnya</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label">Tahun</label>
                    <input type="number" class="form-control" placeholder="Tahun" @bind="SelectedTahun" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="SearchAssets">
                        <i class="bi bi-search"></i> Cari
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetFilters">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Assets Table -->
    <div class="card">
        <div class="card-body">
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Memuat data...</p>
                </div>
            }
            else if (Assets.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="mt-3 text-muted">Tidak ada data aset</p>
                    <button class="btn btn-primary mt-2" @onclick='() => NavigationManager.NavigateTo("/pengelola-barang/saldo-awal/tambah")'>
                        <i class="bi bi-plus-circle"></i> Tambah Aset Pertama
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>No. Register</th>
                                <th>KIB</th>
                                <th>Nama Barang</th>
                                <th>Kode Barang</th>
                                <th>SKPD</th>
                                <th>UPB</th>
                                <th>Tahun</th>
                                <th class="text-end">Harga</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Assets)
                            {
                                <tr>
                                    <td><strong>@asset.NomorRegister</strong></td>
                                    <td><span class="badge bg-info">@asset.KIBType</span></td>
                                    <td>@asset.NamaBarang</td>
                                    <td><small>@asset.KodeBarang.KodeBarang1</small></td>
                                    <td><small>@asset.SKPD.NamaSKPD</small></td>
                                    <td><small>@(asset.UPB?.NamaUPB ?? "-")</small></td>
                                    <td>@asset.Tahun</td>
                                    <td class="text-end">@asset.Harga.ToString("N0")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-info me-1"
                                                @onclick='() => NavigationManager.NavigateTo($"/pengelola-barang/saldo-awal/detail/{asset.Id}")'
                                                title="Detail">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick='() => NavigationManager.NavigateTo($"/pengelola-barang/saldo-awal/edit/{asset.Id}")'
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDelete(asset.Id)"
                                                title="Hapus">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="7" class="text-end">Total:</td>
                                <td class="text-end">@TotalHarga.ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        Menampilkan @((CurrentPage - 1) * PageSize + 1) - @Math.Min(CurrentPage * PageSize, TotalCount) dari @TotalCount data
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            </li>
                            @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (ShowDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Konfirmasi Hapus</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Apakah Anda yakin ingin menghapus aset ini?</p>
                    <p class="text-warning"><strong>Catatan:</strong> Data tidak akan dihapus permanen, hanya dinonaktifkan.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowDeleteConfirm = false">Batal</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteAsset" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Hapus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Lists
    private List<Asset> Assets { get; set; } = new();
    private List<SKPD> SKPDs { get; set; } = new();
    private List<UPB> UPBs { get; set; } = new();

    // Pagination
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    // Filters
    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedSkpdId { get; set; } = string.Empty;
    private string SelectedUpbId { get; set; } = string.Empty;
    private string SelectedKIBType { get; set; } = string.Empty;
    private int? SelectedTahun { get; set; }

    // Delete
    private bool ShowDeleteConfirm { get; set; }
    private int AssetToDeleteId { get; set; }

    // Loading states
    private bool IsLoading { get; set; }
    private bool IsDeleting { get; set; }

    // Summary
    private decimal TotalHarga { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadSKPDs();
        await LoadData();
    }

    private async Task LoadSKPDs()
    {
        SKPDs = await AssetService.GetAllSKPDsAsync();
    }

    private async Task OnSkpdChanged()
    {
        UPBs = new List<UPB>();
        if (!string.IsNullOrEmpty(SelectedSkpdId) && int.TryParse(SelectedSkpdId, out var skpdId))
        {
            UPBs = await AssetService.GetUPBsBySKPDAsync(skpdId);
        }
        SelectedUpbId = string.Empty;
    }

    private async Task LoadData()
    {
        await SearchAssets();
    }

    private async Task SearchAssets()
    {
        IsLoading = true;

        int? skpdId = null;
        if (!string.IsNullOrEmpty(SelectedSkpdId) && int.TryParse(SelectedSkpdId, out var sid))
        {
            skpdId = sid;
        }

        int? upbId = null;
        if (!string.IsNullOrEmpty(SelectedUpbId) && int.TryParse(SelectedUpbId, out var uid))
        {
            upbId = uid;
        }

        KIBType? kibType = null;
        if (!string.IsNullOrEmpty(SelectedKIBType) && Enum.TryParse<KIBType>(SelectedKIBType, out var type))
        {
            kibType = type;
        }

        var result = await AssetService.GetAssetsAsync(
            CurrentPage,
            PageSize,
            SearchTerm,
            skpdId,
            upbId,
            kibType,
            SelectedTahun);

        Assets = result.Assets;
        TotalCount = result.TotalCount;
        TotalHarga = Assets.Sum(a => a.Harga);

        IsLoading = false;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await SearchAssets();
    }

    private async Task ResetFilters()
    {
        SearchTerm = string.Empty;
        SelectedSkpdId = string.Empty;
        SelectedUpbId = string.Empty;
        SelectedKIBType = string.Empty;
        SelectedTahun = null;
        UPBs = new List<UPB>();
        CurrentPage = 1;
        await SearchAssets();
    }

    private void ConfirmDelete(int id)
    {
        AssetToDeleteId = id;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteAsset()
    {
        IsDeleting = true;

        try
        {
            await AssetService.DeleteAssetAsync(AssetToDeleteId);
            ShowDeleteConfirm = false;
            await SearchAssets();
        }
        finally
        {
            IsDeleting = false;
        }
    }
}
