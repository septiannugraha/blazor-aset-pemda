@page "/pengelola-barang/pemanfaatan/ba-pemanfaatan"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>BA Pemanfaatan</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">BA Pemanfaatan</h1>
            <p class="text-muted">Kelola Berita Acara pemanfaatan barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah BA
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-clipboard-check display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur BA pemanfaatan akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar Berita Acara pemanfaatan barang milik daerah</p>
        </div>
    </div>
</div>
