@page "/pengelola-barang/pemanfaatan/monitoring"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Monitoring Pemanfaatan</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Monitoring Pemanfaatan</h1>
            <p class="text-muted">Monitoring pemanfaatan barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-file-earmark-excel"></i> Ekspor Data
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-graph-up display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur monitoring pemanfaatan akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan dashboard monitoring pemanfaatan barang milik daerah</p>
        </div>
    </div>
</div>
