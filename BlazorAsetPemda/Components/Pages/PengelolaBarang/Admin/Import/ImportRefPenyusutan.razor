@page "/pengelola-barang/admin/import/ref-penyusutan"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout
@inject RefPenyusutanImportService ImportService
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS

<PageTitle>Import Ref Penyusutan</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Import Referensi Penyusutan</h1>
            <p class="text-muted">Import data referensi masa manfaat dan tarif penyusutan dari file Excel</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <i class="bi bi-upload me-2"></i>Upload File Excel
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Pilih File (.xls / .xlsx)</label>
                        <InputFile OnChange="OnFileSelected" class="form-control" accept=".xls,.xlsx" disabled="@isLoading" />
                        <div class="form-text">File: Ref_Penyusutan_Labusel_24.xls atau file serupa</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tahun Referensi (opsional)</label>
                        <input type="number" class="form-control" @bind="tahunReferensi" min="2000" max="2100" placeholder="contoh: 2024" />
                    </div>

                    @if (selectedFile != null)
                    {
                        <div class="alert alert-info py-2">
                            <i class="bi bi-file-earmark-excel me-2"></i>
                            <strong>@selectedFile.Name</strong> (@((selectedFile.Size / 1024).ToString("N0")) KB)
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-database me-2"></i>Data di Database</span>
                    <span class="badge bg-primary">@totalCount item</span>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="ImportData" disabled="@(selectedFile == null || isLoading)">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Mengimpor...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-upload me-1"></i>
                                <span>Import ke Database</span>
                            }
                        </button>
                        <button class="btn btn-outline-danger" @onclick="ClearData" disabled="@(totalCount == 0 || isLoading)">
                            <i class="bi bi-trash me-1"></i>Hapus Semua
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="LoadData" disabled="@isLoading">
                            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-eye me-2"></i>Preview Headers
                </div>
                <div class="card-body">
                    @if (excelHeaders.Count == 0)
                    {
                        <p class="text-muted">Pilih file untuk melihat struktur kolom</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var header in excelHeaders)
                            {
                                <li class="list-group-item py-1">@header</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (dataList.Count > 0)
    {
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-table me-2"></i>Data Referensi Penyusutan</span>
                <div>
                    <input type="text" class="form-control form-control-sm" placeholder="Cari..."
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" style="width: 200px;" />
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-bordered table-striped table-hover mb-0" style="font-size: 0.85rem;">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th style="width: 50px;">No</th>
                                <th>Kode Barang</th>
                                <th>Nama Barang</th>
                                <th style="width: 70px;">KIB</th>
                                <th style="width: 80px;">Masa (Th)</th>
                                <th style="width: 80px;">Persen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, index) in dataList.Select((x, i) => (x, i)))
                            {
                                <tr>
                                    <td class="text-center">@(index + 1 + (currentPage - 1) * pageSize)</td>
                                    <td><code>@item.KodeBarang</code></td>
                                    <td>@item.NamaBarang</td>
                                    <td class="text-center">
                                        @if (item.KIBType.HasValue)
                                        {
                                            <span class="badge bg-secondary">@item.KIBType</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.MasaManfaat</td>
                                    <td class="text-end">@(item.PersenPenyusutan?.ToString("N2"))%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (totalCount > pageSize)
            {
                <div class="card-footer">
                    <nav>
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => LoadDataPage(currentPage - 1)">Prev</button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Hal @currentPage / @totalPages</span>
                            </li>
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => LoadDataPage(currentPage + 1)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>

@code {
    private IBrowserFile? selectedFile;
    private List<string> excelHeaders = new();
    private List<RefPenyusutan> dataList = new();
    private bool isLoading = false;
    private string? statusMessage;
    private bool isError = false;
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);
    private string searchTerm = "";
    private int? tahunReferensi;
    private System.Timers.Timer? searchTimer;
    private string? tempFilePath;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            totalCount = await ImportService.GetCountAsync();
            await LoadDataPage(1);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDataPage(int page)
    {
        currentPage = page;
        dataList = await ImportService.GetPagedAsync(page, pageSize, searchTerm);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        excelHeaders.Clear();
        statusMessage = null;

        if (selectedFile != null)
        {
            try
            {
                // Save to temp location
                var tempDir = Path.Combine(Environment.ContentRootPath, "Uploads", "Temp");
                Directory.CreateDirectory(tempDir);
                tempFilePath = Path.Combine(tempDir, $"{Guid.NewGuid()}{Path.GetExtension(selectedFile.Name)}");

                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
                using var fileStream = new FileStream(tempFilePath, FileMode.Create);
                await stream.CopyToAsync(fileStream);

                // Read headers
                excelHeaders = ImportService.GetExcelHeaders(tempFilePath);

                // Try to extract year from filename
                var match = System.Text.RegularExpressions.Regex.Match(selectedFile.Name, @"(\d{2,4})");
                if (match.Success)
                {
                    var year = int.Parse(match.Value);
                    if (year < 100) year += 2000;
                    tahunReferensi = year;
                }
            }
            catch (Exception ex)
            {
                statusMessage = $"Error membaca file: {ex.Message}";
                isError = true;
            }
        }
    }

    private async Task ImportData()
    {
        if (string.IsNullOrEmpty(tempFilePath) || !File.Exists(tempFilePath))
        {
            statusMessage = "File belum dipilih atau tidak ditemukan";
            isError = true;
            return;
        }

        isLoading = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            var result = await ImportService.ImportFromExcelAsync(tempFilePath, null, tahunReferensi);

            if (result.IsSuccess)
            {
                statusMessage = $"Import berhasil! {result.SuccessCount} data baru, {result.UpdatedCount} data diperbarui.";
                isError = false;
                await LoadData();
            }
            else
            {
                statusMessage = $"Import gagal: {string.Join(", ", result.Errors.Take(3))}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearData()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Hapus semua data referensi penyusutan?");
        if (!confirmed) return;

        isLoading = true;
        try
        {
            var success = await ImportService.ClearAllAsync();
            if (success)
            {
                statusMessage = "Data berhasil dihapus";
                isError = false;
                await LoadData();
            }
            else
            {
                statusMessage = "Gagal menghapus data";
                isError = true;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchKeyUp()
    {
        searchTimer?.Stop();
        searchTimer?.Dispose();
        searchTimer = new System.Timers.Timer(300);
        searchTimer.Elapsed += async (s, e) =>
        {
            searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadDataPage(1);
                StateHasChanged();
            });
        };
        searchTimer.AutoReset = false;
        searchTimer.Start();
    }

    public void Dispose()
    {
        searchTimer?.Dispose();

        // Cleanup temp file
        if (!string.IsNullOrEmpty(tempFilePath) && File.Exists(tempFilePath))
        {
            try { File.Delete(tempFilePath); } catch { }
        }
    }
}
