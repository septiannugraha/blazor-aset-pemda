@page "/pengelola-barang/admin/pengguna-barang"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Pengguna Barang dan UPB</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Pengguna Barang dan UPB</h1>
            <p class="text-muted">Kelola data pengguna barang dan Unit Pengguna Barang (UPB)</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Pengguna Barang
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur pengguna barang dan UPB akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar pengguna barang serta Unit Pengguna Barang</p>
        </div>
    </div>
</div>
