@page "/pengelola-barang/admin/kebijakan-akuntansi"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Kebijakan Akuntansi</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Kebijakan Akuntansi</h1>
            <p class="text-muted">Kelola kebijakan akuntansi aset daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Kebijakan
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-book display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur kebijakan akuntansi akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar kebijakan akuntansi untuk aset daerah, termasuk aturan penyusutan</p>
        </div>
    </div>
</div>
