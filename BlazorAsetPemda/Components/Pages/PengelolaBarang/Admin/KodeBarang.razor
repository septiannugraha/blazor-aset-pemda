@page "/pengelola-barang/admin/kode-barang"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Kode Barang</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Kode Barang</h1>
            <p class="text-muted">Kelola master kode barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Kode Barang
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-tag display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur kode barang akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar master kode barang berdasarkan klasifikasi aset</p>
        </div>
    </div>
</div>
