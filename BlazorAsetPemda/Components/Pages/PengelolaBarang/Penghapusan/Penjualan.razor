@page "/pengelola-barang/penghapusan/penjualan"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Penjualan</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Penjualan</h1>
            <p class="text-muted">Kelola penjualan barang milik daerah yang dihapus</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Penjualan
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-cash-coin display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur penjualan akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar penjualan barang milik daerah yang dihapus</p>
        </div>
    </div>
</div>
