@page "/pengelola-barang/penghapusan/penaksiran"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Penaksiran dan Penilaian</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Penaksiran dan Penilaian</h1>
            <p class="text-muted">Kelola penaksiran dan penilaian barang yang akan dihapus</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Penaksiran
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-calculator display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur penaksiran dan penilaian akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar penaksiran serta penilaian barang yang akan dihapus</p>
        </div>
    </div>
</div>
