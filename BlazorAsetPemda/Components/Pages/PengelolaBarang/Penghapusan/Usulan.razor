@page "/pengelola-barang/penghapusan/usulan"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Usulan Penghapusan</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Usulan Penghapusan</h1>
            <p class="text-muted">Kelola usulan penghapusan barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Usulan
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-x display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur usulan penghapusan akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar usulan penghapusan barang milik daerah</p>
        </div>
    </div>
</div>
