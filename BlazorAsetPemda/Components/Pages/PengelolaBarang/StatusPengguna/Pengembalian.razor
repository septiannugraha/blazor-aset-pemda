@page "/pengelola-barang/status-pengguna/pengembalian"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Pengembalian Status</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Pengembalian Status</h1>
            <p class="text-muted">Kelola pengembalian status barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Pengembalian
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-arrow-return-left display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur pengembalian status barang akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar pengembalian status barang milik daerah</p>
        </div>
    </div>
</div>
