@page "/pengelola-barang/belanja-modal/monitoring"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Monitoring - Belanja Modal</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Monitoring Belanja Modal</h1>
            <p class="text-muted">Pemantauan dan Laporan Belanja Modal</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-graph-up display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur Monitoring akan segera tersedia.</p>
            <p class="small text-muted">Menu ini akan berisi dashboard dan laporan monitoring belanja modal.</p>
        </div>
    </div>
</div>
