@page "/pengelola-barang/belanja-modal/paket-pengguna"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Paket Pengguna - Belanja Modal</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Paket Pengguna</h1>
            <p class="text-muted">Manajemen Paket Pengguna Belanja Modal</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Paket
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-box-seam display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur Paket Pengguna akan segera tersedia.</p>
            <p class="small text-muted">Menu ini akan berisi pengaturan paket untuk pengguna barang.</p>
        </div>
    </div>
</div>
