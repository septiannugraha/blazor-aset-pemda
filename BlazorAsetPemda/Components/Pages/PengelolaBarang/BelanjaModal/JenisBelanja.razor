@page "/pengelola-barang/belanja-modal/jenis-belanja"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Jenis Belanja - Belanja Modal</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Jenis Belanja</h1>
            <p class="text-muted">Kategori dan Jenis Belanja Modal</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Jenis Belanja
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-tag display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur Jenis Belanja akan segera tersedia.</p>
            <p class="small text-muted">Menu ini akan berisi klasifikasi jenis belanja modal.</p>
        </div>
    </div>
</div>
