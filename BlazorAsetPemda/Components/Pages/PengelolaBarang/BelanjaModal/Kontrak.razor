@page "/pengelola-barang/belanja-modal/kontrak"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Kontrak/Rincian Kontrak - Belanja Modal</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Kontrak/Rincian Kontrak</h1>
            <p class="text-muted">Manajemen Kontrak Belanja Modal</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Kontrak
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-text display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur Kontrak/Rincian Kontrak akan segera tersedia.</p>
            <p class="small text-muted">Menu ini akan berisi manajemen kontrak pengadaan barang modal.</p>
        </div>
    </div>
</div>
