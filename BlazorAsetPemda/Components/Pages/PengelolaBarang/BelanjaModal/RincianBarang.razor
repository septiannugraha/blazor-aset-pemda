@page "/pengelola-barang/belanja-modal/rincian-barang"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Rincian Barang - Belanja Modal</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Rincian Barang</h1>
            <p class="text-muted">Detail Barang Hasil Belanja Modal</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Rincian
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-list-ul display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur Rincian Barang akan segera tersedia.</p>
            <p class="small text-muted">Menu ini akan berisi detail rincian barang dari belanja modal.</p>
        </div>
    </div>
</div>
