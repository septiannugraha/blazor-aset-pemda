@page "/pengelola-barang/data-umum/upb"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout
@inject UPBService UPBService
@inject IJSRuntime JS

<PageTitle>UPB - Data Umum</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Data UPB</h1>
            <p class="text-muted">Unit Pengguna Barang</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="OpenAddModal">
                <i class="bi bi-plus-circle"></i> Tambah UPB
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Cari</label>
                    <input type="text" class="form-control" placeholder="Kode, Nama UPB, PJ, NIP..."
                           @bind="SearchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">SKPD</label>
                    <select class="form-select" @bind="SelectedSkpdId">
                        <option value="">Semua SKPD</option>
                        @foreach (var skpd in SKPDs)
                        {
                            <option value="@skpd.Id">@skpd.KodeSKPD - @skpd.NamaSKPD</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="SelectedStatus">
                        <option value="">Semua</option>
                        <option value="true">Aktif</option>
                        <option value="false">Tidak Aktif</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="SearchUPBs">
                        <i class="bi bi-search"></i> Cari
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetFilters">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- UPB Table -->
    <div class="card">
        <div class="card-body">
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Memuat data...</p>
                </div>
            }
            else if (UPBs.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="mt-3 text-muted">Tidak ada data UPB</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Kode UPB</th>
                                <th>Nama UPB</th>
                                <th>SKPD</th>
                                <th>Penanggung Jawab</th>
                                <th>NIP</th>
                                <th>Status</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var upb in UPBs)
                            {
                                <tr>
                                    <td><strong>@upb.KodeUPB</strong></td>
                                    <td>@upb.NamaUPB</td>
                                    <td>
                                        <small class="text-muted">@upb.SKPD.KodeSKPD</small><br />
                                        @upb.SKPD.NamaSKPD
                                    </td>
                                    <td>@upb.PenanggungJawab</td>
                                    <td>@upb.NIP</td>
                                    <td>
                                        @if (upb.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tidak Aktif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() => OpenEditModal(upb.Id)"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDelete(upb.Id)"
                                                title="Nonaktifkan">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        Menampilkan @((CurrentPage - 1) * PageSize + 1) - @Math.Min(CurrentPage * PageSize, TotalCount) dari @TotalCount data
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            </li>
                            @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditMode ? "Edit UPB" : "Tambah UPB")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="CurrentUPB" OnValidSubmit="SaveUPB">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Kode UPB <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentUPB.KodeUPB"
                                           placeholder="Contoh: 1.01.01.001" />
                                <ValidationMessage For="() => CurrentUPB.KodeUPB" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nama UPB <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentUPB.NamaUPB"
                                           placeholder="Contoh: Sekretariat" />
                                <ValidationMessage For="() => CurrentUPB.NamaUPB" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">SKPD <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="CurrentUPB.SkpdId">
                                    <option value="0">-- Pilih SKPD --</option>
                                    @foreach (var skpd in SKPDs)
                                    {
                                        <option value="@skpd.Id">@skpd.KodeSKPD - @skpd.NamaSKPD</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => CurrentUPB.SkpdId" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Penanggung Jawab</label>
                                <InputText class="form-control" @bind-Value="CurrentUPB.PenanggungJawab"
                                           placeholder="Nama penanggung jawab" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">NIP</label>
                                <InputText class="form-control" @bind-Value="CurrentUPB.NIP"
                                           placeholder="Nomor Induk Pegawai" />
                            </div>

                            <div class="col-12">
                                <InputCheckbox class="form-check-input" @bind-Value="CurrentUPB.IsActive" id="isActiveCheck" />
                                <label class="form-check-label ms-2" for="isActiveCheck">Aktif</label>
                            </div>
                        </div>
                    </EditForm>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Batal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveUPB" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Simpan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (ShowDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Konfirmasi Nonaktifkan</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Apakah Anda yakin ingin menonaktifkan UPB ini?</p>
                    <p class="text-warning"><strong>Catatan:</strong> Data tidak akan dihapus, hanya dinonaktifkan.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowDeleteConfirm = false">Batal</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteUPB" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Nonaktifkan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Lists
    private List<UPB> UPBs { get; set; } = new();
    private List<SKPD> SKPDs { get; set; } = new();

    // Pagination
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    // Filters
    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedStatus { get; set; } = string.Empty;
    private string SelectedSkpdId { get; set; } = string.Empty;

    // Modal
    private bool ShowModal { get; set; }
    private bool IsEditMode { get; set; }
    private UPB CurrentUPB { get; set; } = new();

    // Delete
    private bool ShowDeleteConfirm { get; set; }
    private int UPBToDeleteId { get; set; }

    // Loading states
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsDeleting { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadSKPDs();
        await LoadData();
    }

    private async Task LoadSKPDs()
    {
        SKPDs = await UPBService.GetAllActiveSKPDsAsync();
    }

    private async Task LoadData()
    {
        await SearchUPBs();
    }

    private async Task SearchUPBs()
    {
        IsLoading = true;

        bool? isActive = null;
        if (!string.IsNullOrEmpty(SelectedStatus) && bool.TryParse(SelectedStatus, out var status))
        {
            isActive = status;
        }

        int? skpdId = null;
        if (!string.IsNullOrEmpty(SelectedSkpdId) && int.TryParse(SelectedSkpdId, out var id))
        {
            skpdId = id;
        }

        var result = await UPBService.GetUPBsAsync(
            CurrentPage,
            PageSize,
            SearchTerm,
            isActive,
            skpdId);

        UPBs = result.UPBs;
        TotalCount = result.TotalCount;

        IsLoading = false;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await SearchUPBs();
    }

    private async Task ResetFilters()
    {
        SearchTerm = string.Empty;
        SelectedStatus = string.Empty;
        SelectedSkpdId = string.Empty;
        CurrentPage = 1;
        await SearchUPBs();
    }

    private void OpenAddModal()
    {
        IsEditMode = false;
        CurrentUPB = new UPB
            {
                IsActive = true,
                SkpdId = 0
            };
        ShowModal = true;
    }

    private async Task OpenEditModal(int id)
    {
        IsEditMode = true;
        var upb = await UPBService.GetUPBByIdAsync(id);
        if (upb != null)
        {
            CurrentUPB = upb;
            ShowModal = true;
        }
    }

    private void CloseModal()
    {
        ShowModal = false;
        CurrentUPB = new();
    }

    private async Task SaveUPB()
    {
        IsSaving = true;

        try
        {
            // Validate SKPD selection
            if (CurrentUPB.SkpdId == 0)
            {
                await JS.InvokeVoidAsync("alert", "Silakan pilih SKPD!");
                IsSaving = false;
                return;
            }

            // Validate unique kode
            if (!await UPBService.IsKodeUPBUniqueAsync(CurrentUPB.KodeUPB, IsEditMode ? CurrentUPB.Id : null))
            {
                await JS.InvokeVoidAsync("alert", "Kode UPB sudah digunakan!");
                IsSaving = false;
                return;
            }

            if (IsEditMode)
            {
                await UPBService.UpdateUPBAsync(CurrentUPB);
            }
            else
            {
                await UPBService.CreateUPBAsync(CurrentUPB);
            }

            CloseModal();
            await SearchUPBs();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(int id)
    {
        UPBToDeleteId = id;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteUPB()
    {
        IsDeleting = true;

        try
        {
            await UPBService.DeleteUPBAsync(UPBToDeleteId);
            ShowDeleteConfirm = false;
            await SearchUPBs();
        }
        finally
        {
            IsDeleting = false;
        }
    }
}
