@page "/pengelola-barang/data-umum/skpd"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout
@inject SKPDService SKPDService
@inject IJSRuntime JS

<PageTitle>SKPD - Data Umum</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Data SKPD</h1>
            <p class="text-muted">Satuan Kerja Perangkat Daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="OpenAddModal">
                <i class="bi bi-plus-circle"></i> Tambah SKPD
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Cari</label>
                    <input type="text" class="form-control" placeholder="Kode, Nama SKPD, Alamat..."
                           @bind="SearchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="SelectedStatus">
                        <option value="">Semua</option>
                        <option value="true">Aktif</option>
                        <option value="false">Tidak Aktif</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="SearchSKPDs">
                        <i class="bi bi-search"></i> Cari
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetFilters">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SKPD Table -->
    <div class="card">
        <div class="card-body">
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Memuat data...</p>
                </div>
            }
            else if (SKPDs.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="mt-3 text-muted">Tidak ada data SKPD</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Kode SKPD</th>
                                <th>Nama SKPD</th>
                                <th>Alamat</th>
                                <th>Telepon</th>
                                <th>Status</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var skpd in SKPDs)
                            {
                                <tr>
                                    <td><strong>@skpd.KodeSKPD</strong></td>
                                    <td>@skpd.NamaSKPD</td>
                                    <td>@skpd.Alamat</td>
                                    <td>@skpd.Telepon</td>
                                    <td>
                                        @if (skpd.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tidak Aktif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() => OpenEditModal(skpd.Id)"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDelete(skpd.Id)"
                                                title="Nonaktifkan">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        Menampilkan @((CurrentPage - 1) * PageSize + 1) - @Math.Min(CurrentPage * PageSize, TotalCount) dari @TotalCount data
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            </li>
                            @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditMode ? "Edit SKPD" : "Tambah SKPD")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="CurrentSKPD" OnValidSubmit="SaveSKPD">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Kode SKPD <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentSKPD.KodeSKPD"
                                           placeholder="Contoh: 1.01.01" />
                                <ValidationMessage For="() => CurrentSKPD.KodeSKPD" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nama SKPD <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentSKPD.NamaSKPD"
                                           placeholder="Contoh: Dinas Pendidikan" />
                                <ValidationMessage For="() => CurrentSKPD.NamaSKPD" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Alamat</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="CurrentSKPD.Alamat"
                                               placeholder="Alamat lengkap SKPD" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Telepon</label>
                                <InputText class="form-control" @bind-Value="CurrentSKPD.Telepon"
                                           placeholder="Nomor telepon" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Status</label>
                                <InputCheckbox class="form-check-input ms-2" @bind-Value="CurrentSKPD.IsActive" />
                                <label class="form-check-label ms-2">Aktif</label>
                            </div>
                        </div>
                    </EditForm>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Batal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveSKPD" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Simpan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (ShowDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Konfirmasi Nonaktifkan</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Apakah Anda yakin ingin menonaktifkan SKPD ini?</p>
                    <p class="text-warning"><strong>Catatan:</strong> Data tidak akan dihapus, hanya dinonaktifkan.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowDeleteConfirm = false">Batal</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteSKPD" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Nonaktifkan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Lists
    private List<SKPD> SKPDs { get; set; } = new();

    // Pagination
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    // Filters
    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedStatus { get; set; } = string.Empty;

    // Modal
    private bool ShowModal { get; set; }
    private bool IsEditMode { get; set; }
    private SKPD CurrentSKPD { get; set; } = new();

    // Delete
    private bool ShowDeleteConfirm { get; set; }
    private int SKPDToDeleteId { get; set; }

    // Loading states
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsDeleting { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await SearchSKPDs();
    }

    private async Task SearchSKPDs()
    {
        IsLoading = true;

        bool? isActive = null;
        if (!string.IsNullOrEmpty(SelectedStatus) && bool.TryParse(SelectedStatus, out var status))
        {
            isActive = status;
        }

        var result = await SKPDService.GetSKPDsAsync(
            CurrentPage,
            PageSize,
            SearchTerm,
            isActive);

        SKPDs = result.SKPDs;
        TotalCount = result.TotalCount;

        IsLoading = false;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await SearchSKPDs();
    }

    private void ResetFilters()
    {
        SearchTerm = string.Empty;
        SelectedStatus = string.Empty;
        CurrentPage = 1;
        StateHasChanged();
    }

    private void OpenAddModal()
    {
        IsEditMode = false;
        CurrentSKPD = new SKPD
        {
            IsActive = true
        };
        ShowModal = true;
    }

    private async Task OpenEditModal(int id)
    {
        IsEditMode = true;
        var skpd = await SKPDService.GetSKPDByIdAsync(id);
        if (skpd != null)
        {
            CurrentSKPD = skpd;
            ShowModal = true;
        }
    }

    private void CloseModal()
    {
        ShowModal = false;
        CurrentSKPD = new();
    }

    private async Task SaveSKPD()
    {
        IsSaving = true;

        try
        {
            // Validate unique kode
            if (!await SKPDService.IsKodeSKPDUniqueAsync(CurrentSKPD.KodeSKPD, IsEditMode ? CurrentSKPD.Id : null))
            {
                await JS.InvokeVoidAsync("alert", "Kode SKPD sudah digunakan!");
                IsSaving = false;
                return;
            }

            if (IsEditMode)
            {
                await SKPDService.UpdateSKPDAsync(CurrentSKPD);
            }
            else
            {
                await SKPDService.CreateSKPDAsync(CurrentSKPD);
            }

            CloseModal();
            await SearchSKPDs();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(int id)
    {
        SKPDToDeleteId = id;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteSKPD()
    {
        IsDeleting = true;

        try
        {
            await SKPDService.DeleteSKPDAsync(SKPDToDeleteId);
            ShowDeleteConfirm = false;
            await SearchSKPDs();
        }
        finally
        {
            IsDeleting = false;
        }
    }
}
