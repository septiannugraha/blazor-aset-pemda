@page "/pengelola-barang/inventarisasi/inventaris-awal"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Inventaris Awal</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Inventaris Awal</h1>
            <p class="text-muted">Kelola data inventaris awal barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Inventaris
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-check display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur inventaris awal akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar inventaris awal barang milik daerah</p>
        </div>
    </div>
</div>
