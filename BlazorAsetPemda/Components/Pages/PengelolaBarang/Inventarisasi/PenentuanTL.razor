@page "/pengelola-barang/inventarisasi/penentuan-tl"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Penentuan TL</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Penentuan TL</h1>
            <p class="text-muted">Penentuan status Tidak Layak (TL) pada barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Penentuan TL
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-flag display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur penentuan TL akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan form dan daftar penentuan status Tidak Layak pada barang</p>
        </div>
    </div>
</div>
