@page "/pengelola-barang/inventarisasi/rekapitulasi"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PengelolaBarang")]
@layout PengelolaBarangLayout

<PageTitle>Rekapitulasi Hasil</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Rekapitulasi Hasil</h1>
            <p class="text-muted">Rekapitulasi hasil inventarisasi barang milik daerah</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">
                <i class="bi bi-file-earmark-excel"></i> Ekspor Rekapitulasi
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-bar-chart display-1 text-muted"></i>
            <h3 class="mt-3">Halaman Dalam Pengembangan</h3>
            <p class="text-muted">Fitur rekapitulasi hasil inventarisasi akan tersedia segera</p>
            <p class="small text-muted">Halaman ini akan menampilkan laporan rekapitulasi hasil inventarisasi fisik barang</p>
        </div>
    </div>
</div>
