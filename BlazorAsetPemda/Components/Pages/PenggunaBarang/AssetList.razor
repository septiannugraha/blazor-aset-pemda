@page "/pengguna-barang/assets"
@attribute [Authorize(Roles = "PenggunaBarang,PengelolaBarang")]
@layout PenggunaBarangLayout
@inject AssetService AssetService

<PageTitle>Daftar Aset - Pengguna Barang</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">Daftar Aset</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="OpenAddModal">
                <i class="bi bi-plus-circle"></i> Tambah Aset
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Cari</label>
                    <input type="text" class="form-control" placeholder="Nama, Nomor Register..."
                           @bind="SearchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">KIB</label>
                    <select class="form-select" @bind="SelectedKIBType">
                        <option value="">Semua</option>
                        @foreach (var kib in Enum.GetValues<KIBType>())
                        {
                            <option value="@kib">KIB @kib</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">SKPD</label>
                    <select class="form-select" @bind="SelectedSKPDId">
                        <option value="0">Semua</option>
                        @foreach (var skpd in SKPDs)
                        {
                            <option value="@skpd.Id">@skpd.NamaSKPD</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tahun</label>
                    <select class="form-select" @bind="SelectedTahun">
                        <option value="0">Semua</option>
                        @for (int year = DateTime.Now.Year; year >= 2010; year--)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="SearchAssets">
                        <i class="bi bi-search"></i> Cari
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetFilters">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Asset Table -->
    <div class="card">
        <div class="card-body">
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Memuat data...</p>
                </div>
            }
            else if (Assets.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="mt-3 text-muted">Tidak ada data aset</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>No. Register</th>
                                <th>Nama Barang</th>
                                <th>KIB</th>
                                <th>SKPD</th>
                                <th>Tahun</th>
                                <th class="text-end">Harga (Rp)</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Assets)
                            {
                                <tr>
                                    <td>@asset.NomorRegister</td>
                                    <td>@asset.NamaBarang</td>
                                    <td><span class="badge bg-info">KIB @asset.KIBType</span></td>
                                    <td>@asset.SKPD?.NamaSKPD</td>
                                    <td>@asset.Tahun</td>
                                    <td class="text-end">@asset.Harga.ToString("N0")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() => OpenEditModal(asset.Id)"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-info me-1"
                                                @onclick="() => ViewAssetDetails(asset.Id)"
                                                title="Detail">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDelete(asset.Id)"
                                                title="Hapus">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        Menampilkan @((CurrentPage - 1) * PageSize + 1) - @Math.Min(CurrentPage * PageSize, TotalCount) dari @TotalCount data
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            </li>
                            @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditMode ? "Edit Aset" : "Tambah Aset")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="CurrentAsset" OnValidSubmit="SaveAsset">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <!-- Basic Information -->
                            <div class="col-12">
                                <h6 class="border-bottom pb-2">Informasi Dasar</h6>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nomor Register <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentAsset.NomorRegister" disabled="@IsEditMode" />
                                @if (!IsEditMode)
                                {
                                    <small class="text-muted">Akan di-generate otomatis</small>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">KIB <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="CurrentAsset.KIBType" @bind-Value:after="OnKIBTypeChanged">
                                    @foreach (var kib in Enum.GetValues<KIBType>())
                                    {
                                        <option value="@kib">KIB @kib</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">SKPD <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="CurrentAsset.SkpdId" @bind-Value:after="OnSKPDChanged">
                                    <option value="0">-- Pilih SKPD --</option>
                                    @foreach (var skpd in SKPDs)
                                    {
                                        <option value="@skpd.Id">@skpd.NamaSKPD</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">UPB</label>
                                <InputSelect class="form-select" @bind-Value="CurrentAsset.UpbId">
                                    <option value="">-- Pilih UPB --</option>
                                    @foreach (var upb in FilteredUPBs)
                                    {
                                        <option value="@upb.Id">@upb.NamaUPB</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Kode Barang <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="CurrentAsset.KodeBarangId">
                                    <option value="0">-- Pilih Kode Barang --</option>
                                    @foreach (var kb in FilteredKodeBarangs)
                                    {
                                        <option value="@kb.Id">@kb.KodeBarang1 - @kb.NamaBarang</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nama Barang <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentAsset.NamaBarang" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Kode Rekening <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="CurrentAsset.KodeRekening" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Tahun <span class="text-danger">*</span></label>
                                <InputNumber class="form-control" @bind-Value="CurrentAsset.Tahun" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Tanggal Perolehan <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="CurrentAsset.TanggalPerolehan" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Harga <span class="text-danger">*</span></label>
                                <InputNumber class="form-control" @bind-Value="CurrentAsset.Harga" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Asal Usul</label>
                                <InputText class="form-control" @bind-Value="CurrentAsset.AsalUsul" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ruangan</label>
                                <InputText class="form-control" @bind-Value="CurrentAsset.Ruangan" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Alamat</label>
                                <InputText class="form-control" @bind-Value="CurrentAsset.Alamat" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Kondisi</label>
                                <InputSelect class="form-select" @bind-Value="CurrentAsset.Kondisi">
                                    <option value="">-- Pilih Kondisi --</option>
                                    <option value="Baik">Baik</option>
                                    <option value="Rusak Ringan">Rusak Ringan</option>
                                    <option value="Rusak Berat">Rusak Berat</option>
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Kontrak</label>
                                <InputSelect class="form-select" @bind-Value="CurrentAsset.KontrakId">
                                    <option value="">-- Pilih Kontrak --</option>
                                    @foreach (var kontrak in Kontraks)
                                    {
                                        <option value="@kontrak.Id">@kontrak.NomorKontrak - @kontrak.NamaPaket</option>
                                    }
                                </InputSelect>
                            </div>

                            <!-- Additional Fields based on KIB Type -->
                            @if (CurrentAsset.KIBType == KIBType.B)
                            {
                                <div class="col-12">
                                    <h6 class="border-bottom pb-2 mt-3">Informasi Kendaraan/Mesin</h6>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Merk</label>
                                    <InputText class="form-control" @bind-Value="CurrentAsset.Merk" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Nomor Rangka</label>
                                    <InputText class="form-control" @bind-Value="CurrentAsset.NomorRangka" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Nomor Mesin</label>
                                    <InputText class="form-control" @bind-Value="CurrentAsset.NomorMesin" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Nomor Polisi</label>
                                    <InputText class="form-control" @bind-Value="CurrentAsset.NomorPolisi" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Nomor BPKB</label>
                                    <InputText class="form-control" @bind-Value="CurrentAsset.NomorBPKB" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Bahan</label>
                                    <InputText class="form-control" @bind-Value="CurrentAsset.Bahan" />
                                </div>
                            }

                            @if (CurrentAsset.KIBType == KIBType.C || CurrentAsset.KIBType == KIBType.D)
                            {
                                <div class="col-12">
                                    <h6 class="border-bottom pb-2 mt-3">Dimensi</h6>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Panjang (m)</label>
                                    <InputNumber class="form-control" @bind-Value="CurrentAsset.Panjang" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Lebar (m)</label>
                                    <InputNumber class="form-control" @bind-Value="CurrentAsset.Lebar" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Luas (m²)</label>
                                    <InputNumber class="form-control" @bind-Value="CurrentAsset.Luas" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Tinggi (m)</label>
                                    <InputNumber class="form-control" @bind-Value="CurrentAsset.Tinggi" />
                                </div>
                            }

                            <div class="col-12">
                                <label class="form-label">Keterangan</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="CurrentAsset.Keterangan" />
                            </div>
                        </div>
                    </EditForm>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Batal</button>
                    <button type="submit" class="btn btn-primary" disabled="@IsSaving" @onclick="SaveAsset">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Simpan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (ShowDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Konfirmasi Hapus</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Apakah Anda yakin ingin menghapus aset ini?</p>
                    <p class="text-danger"><strong>Perhatian:</strong> Tindakan ini tidak dapat dibatalkan!</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowDeleteConfirm = false">Batal</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteAsset">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Hapus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Lists
    private List<Asset> Assets { get; set; } = new();
    private List<SKPD> SKPDs { get; set; } = new();
    private List<UPB> FilteredUPBs { get; set; } = new();
    private List<KodeBarang> FilteredKodeBarangs { get; set; } = new();
    private List<Kontrak> Kontraks { get; set; } = new();

    // Pagination
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    // Filters
    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedKIBType { get; set; } = string.Empty;
    private int SelectedSKPDId { get; set; } = 0;
    private int SelectedTahun { get; set; } = 0;

    // Modal
    private bool ShowModal { get; set; }
    private bool IsEditMode { get; set; }
    private Asset CurrentAsset { get; set; } = new();

    // Delete
    private bool ShowDeleteConfirm { get; set; }
    private int AssetToDeleteId { get; set; }

    // Loading states
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsDeleting { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;

        // Load SKPDs
        SKPDs = await AssetService.GetAllSKPDsAsync();

        // Load assets
        await SearchAssets();

        IsLoading = false;
    }

    private async Task SearchAssets()
    {
        IsLoading = true;

        KIBType? kibFilter = null;
        if (!string.IsNullOrEmpty(SelectedKIBType) && Enum.TryParse<KIBType>(SelectedKIBType, out var kib))
        {
            kibFilter = kib;
        }

        var result = await AssetService.GetAssetsAsync(
            CurrentPage,
            PageSize,
            SearchTerm,
            SelectedSKPDId > 0 ? SelectedSKPDId : null,
            null,
            kibFilter,
            SelectedTahun > 0 ? SelectedTahun : null);

        Assets = result.Assets;
        TotalCount = result.TotalCount;

        IsLoading = false;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await SearchAssets();
    }

    private void ResetFilters()
    {
        SearchTerm = string.Empty;
        SelectedKIBType = string.Empty;
        SelectedSKPDId = 0;
        SelectedTahun = 0;
        CurrentPage = 1;
        StateHasChanged();
    }

    private async Task OpenAddModal()
    {
        IsEditMode = false;
        CurrentAsset = new Asset
        {
            TanggalPerolehan = DateTime.Now,
            Tahun = DateTime.Now.Year,
            KIBType = KIBType.B
        };

        await OnKIBTypeChanged();
        ShowModal = true;
    }

    private async Task OpenEditModal(int id)
    {
        IsEditMode = true;
        var asset = await AssetService.GetAssetByIdAsync(id);
        if (asset != null)
        {
            CurrentAsset = asset;
            await OnSKPDChanged();
            await OnKIBTypeChanged();
            ShowModal = true;
        }
    }

    private void CloseModal()
    {
        ShowModal = false;
        CurrentAsset = new();
    }

    private async Task OnSKPDChanged()
    {
        if (CurrentAsset.SkpdId > 0)
        {
            FilteredUPBs = await AssetService.GetUPBsBySKPDAsync(CurrentAsset.SkpdId);
            Kontraks = await AssetService.GetActiveKontraksAsync(CurrentAsset.SkpdId);
        }
    }

    private async Task OnKIBTypeChanged()
    {
        FilteredKodeBarangs = await AssetService.GetKodeBarangsByKIBAsync(CurrentAsset.KIBType);
    }

    private async Task SaveAsset()
    {
        IsSaving = true;

        try
        {
            if (IsEditMode)
            {
                await AssetService.UpdateAssetAsync(CurrentAsset);
            }
            else
            {
                // Generate nomor register
                CurrentAsset.NomorRegister = await AssetService.GenerateNomorRegisterAsync(
                    CurrentAsset.SkpdId,
                    CurrentAsset.KIBType,
                    CurrentAsset.Tahun);

                await AssetService.CreateAssetAsync(CurrentAsset);
            }

            CloseModal();
            await SearchAssets();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(int id)
    {
        AssetToDeleteId = id;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteAsset()
    {
        IsDeleting = true;

        try
        {
            await AssetService.DeleteAssetAsync(AssetToDeleteId);
            ShowDeleteConfirm = false;
            await SearchAssets();
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private void ViewAssetDetails(int id)
    {
        // TODO: Navigate to detail page or show detail modal
    }
}
