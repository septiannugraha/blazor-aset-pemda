@page "/pengguna-barang/dashboard"
@attribute [Authorize(Roles = "PenggunaBarang")]
@layout PenggunaBarangLayout
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - Pengguna Barang</PageTitle>

<h1 class="mb-4">Dashboard Pengguna Barang</h1>

<FilterComponent OnFilterChange="HandleFilterChange" />

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Total Aset</h6>
                        <h2 class="mb-0">@TotalAssets</h2>
                    </div>
                    <div>
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Total Nilai</h6>
                        <h2 class="mb-0">@TotalValue.ToString("C0")</h2>
                    </div>
                    <div>
                        <i class="bi bi-currency-dollar fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Kontrak Aktif</h6>
                        <h2 class="mb-0">@ActiveContracts</h2>
                    </div>
                    <div>
                        <i class="bi bi-file-earmark-text fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Penyusutan Tahun Ini</h6>
                        <h2 class="mb-0">@CurrentYearDepreciation.ToString("C0")</h2>
                    </div>
                    <div>
                        <i class="bi bi-calculator fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Aset Berdasarkan KIB</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Jenis KIB</th>
                            <th class="text-end">Jumlah</th>
                            <th class="text-end">Nilai (Rp)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in AssetsByKIB)
                        {
                            <tr>
                                <td>KIB @item.KIBType</td>
                                <td class="text-end">@item.Count</td>
                                <td class="text-end">@item.TotalValue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Kontrak Terbaru</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nomor Kontrak</th>
                            <th>Tanggal</th>
                            <th class="text-end">Nilai (Rp)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kontrak in RecentContracts)
                        {
                            <tr>
                                <td>@kontrak.NomorKontrak</td>
                                <td>@kontrak.TanggalKontrak.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@kontrak.NilaiKontrak.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private int TotalAssets { get; set; }
    private decimal TotalValue { get; set; }
    private int ActiveContracts { get; set; }
    private decimal CurrentYearDepreciation { get; set; }
    private List<AssetByKIB> AssetsByKIB { get; set; } = new();
    private List<Kontrak> RecentContracts { get; set; } = new();

    private int? FilteredPenggunaBarangId { get; set; }
    private string FilteredJenisTahun { get; set; } = "sampai-dengan";
    private int FilteredTahun { get; set; } = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task HandleFilterChange(FilterComponent.FilterParameters filters)
    {
        FilteredPenggunaBarangId = filters.PenggunaBarangId > 0 ? filters.PenggunaBarangId : null;
        FilteredJenisTahun = filters.JenisTahun;
        FilteredTahun = filters.Tahun;

        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Assets.AsQueryable();

        // Apply filters
        if (FilteredPenggunaBarangId.HasValue)
        {
            query = query.Where(a => a.UpbId == FilteredPenggunaBarangId.Value);
        }

        if (FilteredJenisTahun == "hanya-tahun")
        {
            query = query.Where(a => a.Tahun == FilteredTahun);
        }
        else
        {
            query = query.Where(a => a.Tahun <= FilteredTahun);
        }

        // Get statistics
        TotalAssets = await query.CountAsync();
        TotalValue = await query.SumAsync(a => (decimal?)a.Harga) ?? 0;

        // Get assets by KIB
        AssetsByKIB = await query
            .GroupBy(a => a.KIBType)
            .Select(g => new AssetByKIB
            {
                KIBType = g.Key,
                Count = g.Count(),
                TotalValue = g.Sum(a => a.Harga)
            })
            .OrderBy(a => a.KIBType)
            .ToListAsync();

        // Get active contracts
        var contractQuery = context.Kontraks.AsQueryable();

        if (FilteredPenggunaBarangId.HasValue)
        {
            var upb = await context.UPBs
                .Include(u => u.SKPD)
                .FirstOrDefaultAsync(u => u.Id == FilteredPenggunaBarangId.Value);

            if (upb != null)
            {
                contractQuery = contractQuery.Where(k => k.SkpdId == upb.SkpdId);
            }
        }

        if (FilteredJenisTahun == "hanya-tahun")
        {
            contractQuery = contractQuery.Where(k => k.Tahun == FilteredTahun);
        }
        else
        {
            contractQuery = contractQuery.Where(k => k.Tahun <= FilteredTahun);
        }

        ActiveContracts = await contractQuery.CountAsync();

        RecentContracts = await contractQuery
            .OrderByDescending(k => k.TanggalKontrak)
            .Take(5)
            .ToListAsync();

        // Get current year depreciation
        var depreciationQuery = context.Depreciations
            .Where(d => d.Tahun == DateTime.Now.Year);

        if (FilteredPenggunaBarangId.HasValue)
        {
            depreciationQuery = depreciationQuery
                .Include(d => d.Asset)
                .Where(d => d.Asset.UpbId == FilteredPenggunaBarangId.Value);
        }

        CurrentYearDepreciation = await depreciationQuery.SumAsync(d => (decimal?)d.NilaiPenyusutan) ?? 0;
    }

    public class AssetByKIB
    {
        public KIBType KIBType { get; set; }
        public int Count { get; set; }
        public decimal TotalValue { get; set; }
    }
}
