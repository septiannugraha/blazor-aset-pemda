# Docker Environment Configuration
# Copy this file to .env and update the values

# SQL Server SA Password (must be strong: 8+ chars, upper, lower, number, special)
SA_PASSWORD=YourStrong@Passw0rd123

# =============================================================================
# For external SQL Server (use with docker-compose.external.yml)
# Uncomment and configure these when connecting to existing SQL Server 2008 R2+
# =============================================================================
# EXTERNAL_SQL_SERVER=192.168.1.100
# EXTERNAL_SQL_DATABASE=BlazorAsetPemdaDb
# EXTERNAL_SQL_USER=sa
# EXTERNAL_SQL_PASSWORD=YourPassword
